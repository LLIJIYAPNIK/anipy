---
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { docSetKey, isSdk } from '../../../data/sdks';
import { docSets } from '../../../lib/mkdocs';
import { loadExamples } from '../../../lib/examples';
import { langs, t, type Key, type Lang } from '../../../i18n';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;

// Примеры SDK и общей документации (ядро) — у каждого набора своя папка в репозитории.
const examples = docSets.flatMap((set) => loadExamples(set));
const plural = new Intl.PluralRules(lang).select(examples.length);
const eyebrow = `${t(lang, 'examples.eyebrow')} · ${examples.length} ${t(lang, `examples.script.${plural}` as Key)}`;

// Вкладки: «Все», SDK и общая документация, у которых есть примеры; у ядра нет номера и каны.
const tabs = [
  { id: 'all', number: '', kana: '', label: t(lang, 'examples.all'), count: examples.length },
  ...docSets
    .map((set) => ({
      id: docSetKey(set),
      number: isSdk(set) ? set.number : '',
      kana: isSdk(set) ? set.kana : '',
      label: docSetKey(set).replace(/-python-sdk$/, ''),
      count: examples.filter((e) => e.set === set).length,
    }))
    .filter((tab) => tab.count > 0),
];
---

<Base lang={lang} title={`${t(lang, 'examples.title')} — ANIPY`} description={t(lang, 'examples.lead')}>
  <SiteHeader lang={lang} current="examples" />

  <main class="page">
    <div class="intro">
      <div class="intro-text" data-rise>
        <div class="meta eyebrow">{eyebrow}</div>
        <h1>{t(lang, 'examples.title')}</h1>
        <p class="lead">{t(lang, 'examples.lead')}</p>
        <p class="note">{t(lang, 'examples.note')}</p>
      </div>
      <span class="vertical" aria-hidden="true" data-parallax>
        <span class="jp" lang="ja" data-draw>実例</span>
        <span class="vertical-label">{t(lang, 'examples.vertical')}</span>
      </span>
    </div>

    <div class="tabs" role="tablist" aria-label="SDK" data-rise style="--i: 2">
      {
        tabs.map((tab, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="examples-list" data-filter={tab.id}>
            {tab.number && <span class="num">{tab.number}</span>}
            {tab.kana && (
              <span class="jp" lang="ja">
                {tab.kana}
              </span>
            )}
            <span class="pkg">{tab.label}</span>
            <span class="count">{tab.count}</span>
          </button>
        ))
      }
    </div>

    <ul id="examples-list" role="tabpanel" class="list">
      {
        examples.map((e, i) => (
          <li data-package={docSetKey(e.set)} data-reveal style={`--i: ${i % 2}`}>
            <span class="num-big" aria-hidden="true">
              {e.num}
            </span>
            <div class="body">
              <div class="item-meta">
                <span>{docSetKey(e.set)}</span>
                {e.account && <span class="account">{t(lang, 'examples.account').toUpperCase()}</span>}
              </div>
              <h2>{e.title[lang]}</h2>
              {e.api && <code class="api">{e.api}</code>}
              <div class="actions">
                <button
                  type="button"
                  class="run"
                  aria-label={`${t(lang, 'examples.copyLabel')} ${e.file}`}
                  data-command={`python ${e.path}`}
                  data-done={t(lang, 'examples.copied')}
                >
                  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
                    <rect x="5" y="5" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.1" />
                    <path d="M11 5V2H2v9h3" fill="none" stroke="currentColor" stroke-width="1.1" />
                  </svg>
                  <span aria-live="polite">$ python {e.path}</span>
                </button>
                <a class="source" href={e.href} target="_blank" rel="noopener noreferrer" aria-label={`${e.file} ${t(lang, 'nav.onGithub')}`}>
                  {t(lang, 'examples.source').toUpperCase()} ↗
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<script>
  import { playEnter } from '../../../scripts/tabs';

  // Вкладки фильтруют один список; #<package> открывает вкладку пакета.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab][data-filter]')];
  const items = [...document.querySelectorAll<HTMLLIElement>('#examples-list li')];
  const select = (tab: HTMLButtonElement, focus = false, animate = true) => {
    const filter = tab.dataset.filter!;
    for (const other of tabs) {
      other.setAttribute('aria-selected', String(other === tab));
      other.tabIndex = other === tab ? 0 : -1;
    }
    for (const item of items) {
      item.hidden = filter !== 'all' && item.dataset.package !== filter;
      // Оставшиеся карточки появляются заново — видно, что список сменился.
      if (!item.hidden && animate) playEnter(item);
    }
    if (focus) tab.focus();
    history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
  };
  for (const tab of tabs) {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (step) select(tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length], true);
    });
  }
  const fromHash = tabs.find((tab) => `#${tab.dataset.filter}` === location.hash);
  if (fromHash) select(fromHash, false, false);

  for (const button of document.querySelectorAll<HTMLButtonElement>('.run')) {
    const label = button.querySelector('[aria-live]')!;
    const idle = label.textContent;
    button.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(button.dataset.command ?? '').catch(() => {});
      label.textContent = button.dataset.done ?? idle;
      button.classList.add('is-done');
      setTimeout(() => {
        label.textContent = idle;
        button.classList.remove('is-done');
      }, 1800);
    });
  }
</script>

<style>
  .page {
    max-width: 90rem;
    margin: 0 auto;
    padding: 4.5rem var(--page-gutter) 7.5rem;
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }
  .intro-text {
    flex: 1 1 35rem;
    min-width: 0;
    max-width: 48.75rem;
  }
  .eyebrow {
    font-size: var(--meta-size-lg);
  }
  h1 {
    margin: 1.375rem 0 0;
    font-weight: 400;
    font-size: 4rem;
    line-height: 1.05;
  }
  .lead {
    margin: 1.625rem 0 0;
    font-size: 1.375rem;
    line-height: 1.55;
    color: var(--body-soft);
  }
  .note {
    margin: 0.875rem 0 0;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--secondary);
  }
  .vertical {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .vertical .jp {
    writing-mode: vertical-rl;
    font-size: 4.75rem;
  }
  .vertical-label {
    writing-mode: vertical-rl;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 0.375rem;
  }

  .tabs {
    margin-top: 4rem;
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--divider);
  }
  [role='tab'] {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 0 0.875rem;
    margin: 0 2.5rem -1px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .num {
    font-weight: 300;
    font-size: 1.375rem;
    letter-spacing: 0.06em;
  }
  [role='tab'] .jp {
    font-size: 1.0625rem;
    line-height: inherit;
  }
  .pkg {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    color: var(--muted);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 35rem), 1fr));
    border-left: 1px solid var(--divider);
  }
  .list li {
    display: flex;
    gap: 1.75rem;
    padding: 2rem 1.75rem 1.75rem;
    border-right: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
  }
  .list li[hidden] {
    display: none;
  }
  .num-big {
    flex: 0 0 3rem;
    font-weight: 300;
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--body-soft);
  }
  .body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  .account {
    padding: 2px 0.375rem;
    border: 1px solid var(--rule);
    color: var(--body-soft);
  }
  h2 {
    margin: 0;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .api {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--secondary);
  }
  .actions {
    margin-top: 0.625rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.125rem;
  }
  .run {
    height: 2.25rem;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    cursor: pointer;
  }
  .run span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .source {
    padding: 0.625rem 0;
    font-family: var(--font-mono);
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    color: var(--secondary);
  }
  .source:hover {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .page {
      padding-top: 2.5rem;
    }
    h1 {
      font-size: 2.75rem;
    }
    .vertical {
      display: none;
    }
    .list li {
      gap: 1.125rem;
      padding: 1.5rem 1rem;
    }
    .num-big {
      flex-basis: 2.25rem;
      font-size: 2rem;
    }
  }
</style>
