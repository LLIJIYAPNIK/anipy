---
// Страница документации из репозитория SDK (#63): файл из nav mkdocs.yml → HTML в стиле сайта.
// Набор — SDK коллекции или общая документация нескольких SDK (ядро, #65).
import { readFileSync } from 'node:fs';
import DocsLayout from '../../../../components/DocsLayout.astro';
import { docSetKey, isSdk, repoRootFileUrl, type DocSet } from '../../../../data/sdks';
import { docSets, docsNav, docsPages, docsRoot, docUrl, findDoc, repoRoot, type DocPage } from '../../../../lib/mkdocs';
import { renderDoc, type RenderOptions } from '../../../../lib/markdown';
import { directive, resolveRef, type ApiContext } from '../../../../lib/api-reference';
import { langs, t, type Lang } from '../../../../i18n';

export const getStaticPaths = () =>
  langs.flatMap((lang) =>
    docSets.flatMap((set) => docsPages(set).map((page) => ({ params: { lang, package: docSetKey(set), slug: page.slug }, props: { set, page } }))),
  );

const { set, page } = Astro.props as { set: DocSet; page: DocPage };
const key = docSetKey(set);
const lang = Astro.params.lang as Lang;

const md: RenderOptions = {
  repoRoot: repoRoot(set),
  file: page.file,
  resolveDoc: (file) => findDoc(lang, set, file),
  repoUrl: (path) => repoRootFileUrl(set, path),
  labels: { copy: t(lang, 'docs.copy'), copied: t(lang, 'docs.copied'), copyCode: t(lang, 'docs.copyCode') },
  resolveRef: (path) => resolveRef(lang, set, path),
};
// Справочник API (#64): директивы `::: путь` — объекты из .sdk/api (scripts/api-reference.py).
const api: ApiContext = {
  lang,
  sdk: set,
  md,
  labels: {
    sections: {
      parameters: t(lang, 'api.parameters'),
      'other parameters': t(lang, 'api.otherParameters'),
      attributes: t(lang, 'api.attributes'),
      raises: t(lang, 'api.raises'),
      warns: t(lang, 'api.warns'),
      returns: t(lang, 'api.returns'),
      yields: t(lang, 'api.yields'),
      receives: t(lang, 'api.receives'),
      examples: t(lang, 'api.examples'),
      deprecated: t(lang, 'api.deprecated'),
    },
    columns: { name: t(lang, 'api.colName'), type: t(lang, 'api.colType'), description: t(lang, 'api.colDescription'), default: t(lang, 'api.colDefault') },
    kinds: Object.fromEntries(
      (['class', 'function', 'method', 'property', 'attribute', 'module', 'async', 'classmethod', 'staticmethod', 'abstractmethod'] as const).map((k) => [k, t(lang, `api.${k}`)]),
    ),
    bases: t(lang, 'api.bases'),
    source: t(lang, 'api.source').toUpperCase(),
  },
  sourceUrl: (file, start, end) => `${repoRootFileUrl(set, file)}#L${start}-L${end}`,
};
md.renderDirective = (ident) => directive(ident, api);
const doc = await renderDoc(readFileSync(`${docsRoot(set)}/${page.file}`, 'utf8'), md);
const heading = doc.title ?? page.title;
// Группа nav, если она не повторяет название набора (раздел libsocial-core у ядра).
const navGroup = docsNav(set).find((g) => g.items.some((it) => 'page' in it && it.page === page))?.title;
const group = navGroup !== key ? navGroup : undefined;

// «Назад» с первой страницы SDK — его обзор; у общей документации обзора нет.
const pages = docsPages(set);
const index = pages.indexOf(page);
const prev =
  index > 0
    ? { href: docUrl(lang, set, pages[index - 1]), title: pages[index - 1].title }
    : isSdk(set)
      ? { href: docUrl(lang, set), title: t(lang, 'docs.overview') }
      : undefined;
const next = pages[index + 1] && { href: docUrl(lang, set, pages[index + 1]), title: pages[index + 1].title };
---

<DocsLayout lang={lang} set={set} title={heading === key ? `${key} — ANIPY` : `${heading} — ${key} — ANIPY`} description={set.description[lang]} toc={doc.toc} page={page}>
  <article>
    <div class="meta overline" data-rise style="--i: 0">
      {isSdk(set) && `${set.number} — `}
      {key.toUpperCase()}{group && ` · ${group.toUpperCase()}`}
    </div>
    <h1 data-rise style="--i: 1">{heading}</h1>
    {
      // Документация SDK только на английском (#67): на русской версии — пометка и исходный файл.
      lang !== 'en' && (
        <p class="original" data-rise style="--i: 2">
          {t(lang, 'docs.original')}{' '}
          <a href={repoRootFileUrl(set, `docs/${page.file}`)} target="_blank" rel="noopener noreferrer">
            {t(lang, 'docs.sourceFile')} ↗
          </a>
        </p>
      )
    }
    <div class="prose" data-rise style="--i: 3" set:html={doc.html} />

    <nav class="pager" aria-label={t(lang, 'docs.pages')}>
      {
        prev && (
          <a class="prev" href={prev.href}>
            <span class="meta">← {t(lang, 'docs.prev').toUpperCase()}</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="next" href={next.href}>
            <span class="meta">{t(lang, 'docs.next').toUpperCase()} →</span>
            <span class="pager-title">{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</DocsLayout>

<script>
  import '../../../../scripts/copy';
</script>

<style>
  article {
    max-width: 47.5rem;
  }
  .overline {
    font-size: var(--meta-size-lg);
  }
  h1 {
    margin: 1.25rem 0 0;
    font-weight: 400;
    font-size: 3.25rem;
    line-height: 1.1;
    letter-spacing: -0.005em;
  }

  .original {
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--secondary);
  }
  .original a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--hover-duration) var(--ease-out);
  }
  .original a:hover {
    text-decoration-color: var(--ink);
  }

  /* Текст документа: разметка приходит из lib/markdown.ts, поэтому :global внутри .prose. */
  .prose {
    margin-top: 2.5rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--body-soft);
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(:is(h2, h3, h4)) {
    color: var(--ink);
    line-height: 1.25;
  }
  .prose :global(h2) {
    margin: 3.5rem 0 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--divider);
    font-weight: 500;
    font-size: 2.125rem;
  }
  .prose :global(h3) {
    margin: 2.5rem 0 0;
    font-weight: 500;
    font-size: 1.5rem;
  }
  .prose :global(h4) {
    margin: 2rem 0 0;
    font-weight: 500;
    font-size: 1.25rem;
  }
  .prose :global(:is(p, ul, ol, blockquote)) {
    margin: 1rem 0 0;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.5rem;
  }
  .prose :global(li + li),
  .prose :global(li > :is(ul, ol)) {
    margin-top: 0.375rem;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--hover-duration) var(--ease-out);
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--rule-faint);
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .prose :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
    color: var(--secondary);
  }
  .prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--divider);
  }

  .prose :global(.table-wrap) {
    margin-top: 1.5rem;
    overflow-x: auto;
    border-top: 1px solid var(--divider);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.5;
  }
  .prose :global(th) {
    text-align: left;
    padding: 0.875rem 1rem 0.875rem 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--divider);
  }
  .prose :global(td) {
    padding: 0.875rem 1rem 0.875rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--divider);
  }

  .prose :global(.admonition) {
    margin: 1.75rem 0 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--divider);
    border-left-color: var(--ink);
    background: var(--row-open);
  }
  .prose :global(.admonition-warning) {
    border-left-width: 3px;
  }
  .prose :global(.admonition > :first-child) {
    margin-top: 0;
  }
  .prose :global(.admonition-title) {
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    letter-spacing: var(--meta-tracking);
    text-transform: uppercase;
    color: var(--ink);
  }
  .prose :global(.admonition-title code) {
    border: 0;
    padding: 0;
    background: none;
    font-size: inherit;
  }

  /* Блоки кода — как components/CodeBlock.astro. */
  .prose :global(figure.code) {
    margin: 1.5rem 0 0;
  }
  .prose :global(figure.code figcaption) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .prose :global(.copy) {
    height: 2.25rem;
    margin-bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--secondary);
    cursor: pointer;
  }
  .prose :global(pre) {
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--divider);
    background: var(--code-bg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    font-variant-ligatures: none;
    color: var(--ink);
  }
  .prose :global(pre code) {
    font: inherit;
  }

  /* Справочник API (lib/api-reference.ts): объект — заголовок с плашками, сигнатура, описание,
     члены — с отступом под линией. */
  .prose :global(.api) {
    margin-top: 2.5rem;
  }
  .prose > :global(.api) {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--divider);
  }
  .prose :global(:is(h2, h3, h4, h5, h6) + .api) {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: 0;
  }
  .prose :global(.api-head) {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }
  .prose :global(.api-head .api-name) {
    padding: 0;
    border: 0;
    background: none;
    font-size: 1.375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .prose :global(.api-members .api-head .api-name) {
    font-size: 1.0625rem;
  }
  .prose :global(.api-chips) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .prose :global(.api-chip) {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--meta-size);
    letter-spacing: var(--meta-tracking);
    text-transform: uppercase;
    color: var(--secondary);
  }
  .prose :global(.api-sig) {
    margin-top: 0.875rem;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
  }
  .prose :global(.api-sig a) {
    text-decoration-color: var(--divider);
  }
  .prose :global(.api-sig-name) {
    font-weight: 600;
  }
  .prose :global(.api-param) {
    color: var(--body-soft);
  }
  .prose :global(.api-bases) {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--secondary);
  }
  .prose :global(.api-bases .meta) {
    margin-right: 0.5rem;
  }
  .prose :global(.api-section-title) {
    margin: 1.75rem 0 0;
    font-size: var(--meta-size-lg);
  }
  .prose :global(.api-section .table-wrap) {
    margin-top: 0.75rem;
  }
  .prose :global(.api-section td > p) {
    margin: 0;
  }
  /* Имена и типы переносятся только по пробелам (`int | None`), не посреди слова. */
  .prose :global(.api-section td code) {
    overflow-wrap: normal;
  }
  .prose :global(.api-section td:first-child code) {
    white-space: nowrap;
  }
  .prose :global(.api-source) {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.375rem 0;
    font-size: var(--meta-size-lg);
    color: var(--muted);
    text-decoration: none;
  }
  .prose :global(.api-source:hover) {
    color: var(--ink);
  }
  .prose :global(.api-members) {
    margin-top: 1.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule-faint);
  }

  .pager {
    margin-top: 5.5rem;
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--divider);
  }
  .pager a {
    flex: 1 1 16.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem 1.5rem 1.5rem 0;
  }
  .pager .next {
    align-items: flex-end;
    text-align: right;
    padding: 1.75rem 0 1.5rem 1.5rem;
    border-left: 1px solid var(--divider);
  }
  .pager .next:first-child {
    border-left: 0;
  }
  .pager-title {
    font-size: 1.375rem;
    line-height: 1.3;
  }

  @media (max-width: 767px) {
    h1 {
      font-size: 2.375rem;
    }
    .prose {
      font-size: 1.125rem;
    }
    .prose :global(h2) {
      font-size: 1.75rem;
    }
    .pager a,
    .pager .next {
      padding: 1.5rem 0;
      border-left: 0;
    }
    .pager .next {
      border-top: 1px solid var(--divider);
    }
  }
</style>
