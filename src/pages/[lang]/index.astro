---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import GithubIcon from '../../components/GithubIcon.astro';
import SdkPanel from '../../components/SdkPanel.astro';
import { owner, sdks } from '../../data/sdks';
import { langs, t, type Lang } from '../../i18n';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const ownerName = owner.split('/').pop();
---

<Base lang={lang} title="ANIPY" description={t(lang, 'site.tagline')}>
  <div class="home">
    <header class="brand">
      <Logo lang={lang} />
      <span class="meta tagline-meta">ANIME × PYTHON</span>
    </header>

    <div class="tools">
      <LangSwitch lang={lang} />
      <a class="about" href={`/${lang}/about/`}>
        <span class="jp" lang="ja">概要</span><span class="about-word">{t(lang, 'nav.about').toUpperCase()}</span>
      </a>
    </div>

    <section class="intro">
      <div class="name" data-rise style="--i: 1">
        <h1 class="jp">ANIPY</h1>
        <span class="name-sub">{t(lang, 'site.name')}</span>
      </div>
      <p class="jp-line jp" lang="ja" data-rise style="--i: 2">アニメ・ラノベ・漫画のための<br />Python SDK コレクション。</p>
      <p class="tagline" data-rise style="--i: 3">{t(lang, 'site.tagline')}</p>
      <p class="lead" data-rise style="--i: 4">{t(lang, 'site.intro')}</p>
    </section>

    <footer class="foot" data-rise style="--i: 5">
      <a class="foot-github" href={owner} target="_blank" rel="noopener noreferrer" aria-label={`${ownerName} ${t(lang, 'nav.onGithub')}`}>
        <GithubIcon />
      </a>
      <span class="meta">{t(lang, 'site.footer')}</span>
    </footer>

    <nav class="panels" aria-label={t(lang, 'nav.collection')}>
      {sdks.map((sdk, i) => <SdkPanel sdk={sdk} lang={lang} index={i} />)}
    </nav>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.accordion button')) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      // Высота раскрывается плавно (SdkPanel.astro); закрытое содержимое недоступно с клавиатуры.
      button.closest('.accordion')?.classList.toggle('is-open', open);
      const body = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (body) body.inert = !open;
    });
  }
</script>

<style>
  /* Макет 1440×900: блоки позиционированы от краёв экрана, панели — от 6.25rem до низа. */
  .home {
    position: relative;
    min-height: max(100vh, 45rem);
    overflow: hidden;
  }
  .brand {
    position: absolute;
    top: 2.125rem;
    left: var(--page-gutter);
    display: flex;
    align-items: center;
    gap: 1.125rem;
  }
  .tagline-meta {
    letter-spacing: 0.22em;
  }
  .tools {
    position: absolute;
    top: 2.125rem;
    right: var(--page-gutter);
    height: var(--tap-min);
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .about {
    height: var(--tap-min);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    letter-spacing: 0.22em;
  }
  .about .jp {
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
  }
  .intro {
    position: absolute;
    left: 5.5rem;
    bottom: 9.375rem;
    width: 26.25rem;
  }
  .name {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }
  h1 {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: 0.14em;
  }
  .name-sub {
    font-size: 1.0625rem;
    font-style: italic;
    letter-spacing: 0.06em;
    color: var(--tertiary);
  }
  .jp-line {
    margin: 2.125rem 0 0;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 2;
    letter-spacing: 0.08em;
  }
  .tagline {
    margin: 1.625rem 0 0;
    max-width: 20rem;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: 0.005em;
  }
  .lead {
    margin: 0.875rem 0 0;
    max-width: 22.5rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--secondary);
  }
  .foot {
    position: absolute;
    left: 5.5rem;
    bottom: 2.875rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .foot-github {
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.8125rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .panels {
    position: absolute;
    inset: var(--panels-top) var(--panels-right) 0 var(--intro-width);
    display: flex;
    border-right: 1px solid var(--divider);
  }
  /* Наведение/фокус: раскрытая панель — треть окна, но не шире 640px; соседние делят остаток.
     :global целиком — Astro не разворачивает :global() внутри :has(). */
  :global(.panels .panel:is(:hover, :focus-within)) {
    flex-grow: 0;
    flex-basis: min(33vw, 640px);
  }

  /* Планшетная ширина: панелям не хватает места справа от вводного блока —
     вводный блок сверху, панели под ним во всю ширину. */
  @media (min-width: 768px) and (max-width: 1100px) {
    .home {
      display: flex;
      flex-direction: column;
    }
    .intro,
    .foot,
    .panels {
      position: static;
    }
    .intro {
      width: auto;
      max-width: 34rem;
      padding: 9rem var(--page-gutter) 3rem;
    }
    .panels {
      height: max(60vh, 32rem);
      margin: 0 var(--page-gutter);
    }
    .foot {
      order: 1;
      padding: 2rem var(--page-gutter) 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .home {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .brand,
    .tools,
    .intro,
    .foot,
    .panels {
      position: static;
    }
    .brand {
      padding: 1.125rem 0.75rem 1.125rem 1.25rem;
    }
    .brand .tagline-meta {
      display: none;
    }
    .tools {
      order: -1;
      position: absolute;
      top: 1.125rem;
      right: 0.75rem;
      gap: 0.75rem;
    }
    .about-word {
      display: none;
    }
    .intro {
      width: auto;
      padding: 2.5rem 1.25rem 3rem;
    }
    .jp-line {
      margin-top: 1.625rem;
      font-size: 0.875rem;
    }
    .tagline {
      margin-top: 1.25rem;
      font-size: 1.3125rem;
      max-width: none;
    }
    .lead {
      margin-top: 0.75rem;
      max-width: none;
    }
    .panels {
      display: block;
      border-right: 0;
      border-top: 1px solid var(--divider);
    }
    .foot {
      order: 1;
      padding: 2rem 1.25rem 2.5rem;
    }
    .foot-github {
      margin-left: -0.8125rem;
    }
  }
</style>
