---
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import GithubButton from '../../../components/GithubButton.astro';
import { owner, sdks } from '../../../data/sdks';
import { langs, t, type Key, type Lang } from '../../../i18n';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const ownerName = owner.split('/').pop()!;

const chapters: { number: string; title: Key; paragraphs: Key[] }[] = [
  { number: 'I', title: 'about.whatTitle', paragraphs: ['about.what1', 'about.what2'] },
  { number: 'II', title: 'about.whyTitle', paragraphs: ['about.why1', 'about.why2'] },
];
---

<Base lang={lang} title={`${t(lang, 'nav.about')} — ANIPY`} description={t(lang, 'about.lead')}>
  <SiteHeader lang={lang} current="about" />

  <main>
    <section class="hero">
      <div class="hero-logo">
        <!-- Знак и надпись раздельно: сначала дорисовывается круг, потом проявляется надпись. -->
        <figure class="brand-mark" role="img" aria-label={t(lang, 'about.logoAlt')}>
          <img data-draw-circle src="/logo.png" alt="" width="410" height="410" />
          <figcaption class="wordmark" aria-hidden="true" data-rise style="--after: var(--draw-duration)">
            <span class="wm-name">anipy</span>
            <span class="wm-tag">ANIME × PYTHON</span>
          </figcaption>
        </figure>
      </div>
      <div class="hero-text">
        <div class="hero-copy" data-rise style="--after: calc(var(--draw-duration) + var(--stagger) * 3)">
          <div class="meta eyebrow">{t(lang, 'about.eyebrow')}</div>
          <h1>{t(lang, 'about.title')}</h1>
          <p class="lead">{t(lang, 'about.lead')}</p>
          <div class="meta hero-meta">{t(lang, 'site.footer')}</div>
        </div>
        <span class="vertical" aria-hidden="true" data-parallax>
          <!-- Иероглифы — последними, после круга, надписи и текста. -->
          <span class="jp" lang="ja" data-draw style="--after: calc(var(--draw-duration) + var(--rise-duration) + var(--stagger) * 4)">概要</span>
          <span class="vertical-label">{t(lang, 'nav.about')}</span>
        </span>
      </div>
    </section>

    {
      chapters.map((c) => (
        <section class="chapter" data-reveal>
          <div class="chapter-head">
            <div class="chapter-num">{c.number}</div>
            <h2>{t(lang, c.title)}</h2>
          </div>
          <div class="chapter-body">
            {c.paragraphs.map((p) => (
              <p>{t(lang, p)}</p>
            ))}
          </div>
        </section>
      ))
    }

    <section class="chapter" data-reveal>
      <div class="chapter-head">
        <div class="chapter-num">III</div>
        <h2>{t(lang, 'about.markTitle')}</h2>
      </div>
      <div class="chapter-body mark">
        <img src="/logo.png" alt={t(lang, 'about.emblemAlt')} width="180" height="180" />
        <div class="mark-text">
          <p>
            <span class="jp-inline" lang="ja">ア</span>
            {t(lang, 'about.mark1a')}
            <span class="jp-inline" lang="ja">アニメ</span>{t(lang, 'about.mark1b')}
          </p>
          <p>{t(lang, 'about.mark2')}</p>
        </div>
      </div>
    </section>

    <section class="collection">
      <div class="meta eyebrow">{t(lang, 'about.collection')}</div>
      <ul>
        {
          sdks.map((sdk, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <span class="c-num">{sdk.number}</span>
              <span class="c-kana jp" lang="ja">
                {sdk.kana}
              </span>
              <span class="c-text">
                <span class="c-pkg">{sdk.package}</span>
                <span class="c-desc">{sdk.description[lang]}</span>
              </span>
              <a class="c-docs" href={`/${lang}/docs/${sdk.package}/`}>
                {t(lang, 'nav.docs').toUpperCase()} ↗
              </a>
              <GithubButton href={sdk.github} label={`${sdk.package} ${t(lang, 'nav.onGithub')}`} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot meta">
    <span>
      {t(lang, 'about.maintained')}{' '}
      <a href={owner} target="_blank" rel="noopener noreferrer">{ownerName.toUpperCase()} ↗</a>
    </span>
    <span>ANIPY.RU</span>
  </footer>
</Base>

<style>
  section,
  .foot {
    max-width: 90rem;
    margin: 0 auto;
  }
  .eyebrow {
    font-size: var(--meta-size-lg);
    letter-spacing: 0.22em;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--divider);
  }
  .hero-logo {
    flex: 1 1 32.5rem;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    border-right: 1px solid var(--divider);
  }
  /* Пропорции — как в логотипе макета: надпись в 1.6 раза шире круга. */
  .brand-mark {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand-mark img {
    display: block;
    width: 15rem;
    height: 15rem;
  }
  .wordmark {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }
  .wm-name {
    font-size: 5.25rem;
    line-height: 1;
    letter-spacing: 0.42em;
    /* Разрядка добавляет пробел после последней буквы — компенсируем, чтобы слово стояло по центру. */
    margin-right: -0.42em;
  }
  .wm-tag {
    font-size: 1.0625rem;
    letter-spacing: 0.5em;
    margin-right: -0.5em;
  }
  .hero-text {
    flex: 1 1 30rem;
    min-width: 0;
    padding: 6rem 5rem 4.5rem;
    display: flex;
    gap: 3rem;
  }
  .hero-copy {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  h1 {
    margin: 1.75rem 0 0;
    font-weight: 400;
    font-size: 3.75rem;
    line-height: 1.05;
    letter-spacing: -0.005em;
  }
  .lead {
    margin: 2rem 0 0;
    max-width: 30rem;
    font-size: 1.3125rem;
    line-height: 1.55;
    color: var(--body-soft);
  }
  .hero-meta {
    margin-top: auto;
    padding-top: 3rem;
  }
  .vertical {
    flex: 0 0 auto;
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .vertical .jp {
    writing-mode: vertical-rl;
    font-size: var(--jp-size);
  }
  .vertical-label {
    writing-mode: vertical-rl;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 0.375rem;
  }

  .chapter {
    padding: 6rem var(--page-gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 3rem 5rem;
    border-bottom: 1px solid var(--divider);
  }
  .chapter-head {
    flex: 1 1 18.75rem;
    min-width: 0;
  }
  .chapter-num {
    font-weight: 300;
    font-size: 5.5rem;
    line-height: 0.85;
    letter-spacing: 0.04em;
  }
  h2 {
    margin: 1.75rem 0 0;
    font-weight: 500;
    font-size: 2.125rem;
  }
  .chapter-body {
    flex: 2 1 35rem;
    min-width: 0;
    max-width: 47.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 1.3125rem;
    line-height: 1.6;
    color: var(--body-soft);
  }
  .chapter-body p {
    margin: 0;
  }
  .mark {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2rem 3rem;
  }
  .mark img {
    flex: 0 0 auto;
    display: block;
    width: 11.25rem;
    height: 11.25rem;
  }
  .mark-text {
    flex: 1 1 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .jp-inline {
    font-family: var(--font-jp);
    font-weight: 800;
    color: var(--ink);
  }

  .collection {
    padding: 6rem var(--page-gutter) 3.5rem;
  }
  .collection ul {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--divider);
  }
  .collection li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--divider);
  }
  .c-num {
    flex: 0 0 4.5rem;
    font-weight: 300;
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .c-kana {
    flex: 0 0 8.75rem;
    font-size: 2.125rem;
  }
  .c-text {
    flex: 1 1 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .c-pkg {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  .c-desc {
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--secondary);
  }
  .c-docs {
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    letter-spacing: var(--meta-tracking);
    padding: 0.875rem 0;
  }

  .foot {
    padding: 2.5rem var(--page-gutter) 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .foot a {
    display: inline-block;
    padding: 0.875rem 0;
  }

  @media (max-width: 767px) {
    .hero-logo {
      border-right: 0;
      border-bottom: 1px solid var(--divider);
    }
    .brand-mark img {
      width: 10rem;
      height: 10rem;
    }
    .wm-name {
      font-size: 3.5rem;
    }
    .wm-tag {
      font-size: 0.8125rem;
    }
    .hero-text {
      padding: 3rem var(--page-gutter);
    }
    .vertical {
      display: none;
    }
    h1 {
      font-size: 2.625rem;
    }
    .chapter {
      padding: 4rem var(--page-gutter);
    }
    .chapter-num {
      font-size: 4rem;
    }
  }
</style>
