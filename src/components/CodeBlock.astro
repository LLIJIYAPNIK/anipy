---
import { Code } from 'astro:components';
import { grayscale } from '../lib/grayscale-theme';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  caption: string;
  copyLabel: string;
  /** Текст, который копирует кнопка. */
  copy: string;
  /** Python-код подсвечивается; без него — содержимое слота как есть. */
  code?: string;
}

const { lang, caption, copyLabel, copy, code } = Astro.props;
---

<figure class="code">
  <figcaption>
    <span class="meta">{caption}</span>
    <button class="copy meta" type="button" aria-label={copyLabel} data-copy={copy} data-done={t(lang, 'docs.copied').toUpperCase()}>
      <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="5" y="5" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.1"></rect>
        <path d="M11 5V2H2v9h3" fill="none" stroke="currentColor" stroke-width="1.1"></path>
      </svg>
      <span aria-live="polite">{t(lang, 'docs.copy').toUpperCase()}</span>
    </button>
  </figcaption>
  {code ? <Code code={code} lang="python" theme={grayscale} /> : <pre><slot /></pre>}
</figure>

<script>
  import '../scripts/copy';
</script>

<style>
  figure {
    margin: 1.5rem 0 0;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .copy {
    height: 2.25rem;
    margin-bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--secondary);
    cursor: pointer;
  }
  figure :global(pre) {
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--divider);
    background: var(--code-bg) !important;
    overflow-x: auto;
    font-family: 'JetBrains Mono', Consolas, ui-monospace, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
    font-variant-ligatures: none;
    color: var(--ink);
  }
  figure :global(pre code) {
    font: inherit;
  }
</style>
