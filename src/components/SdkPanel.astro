---
import CoverWall from './CoverWall.astro';
import GithubButton from './GithubButton.astro';
import ReadingLine from './ReadingLine.astro';
import type { Sdk } from '../data/sdks';
import { latestVersion } from '../lib/versions';
import { t, type Lang } from '../i18n';

interface Props {
  sdk: Sdk;
  lang: Lang;
  /** Порядок панели: задержка появления и «письма» каны. */
  index?: number;
}

const { sdk, lang, index = 0 } = Astro.props;
// Панели появляются после вводного блока (data-rise --i 1–5 на главной).
const order = `--i: ${index + 6}`;
// Кана «пишется» после того, как появились все панели, — по одной, каждая следующая
// со сдвигом в полдлительности (очерёдность, #45). Только токены: reduced motion обнулит.
const drawOrder = `--after: calc(var(--rise-duration) + var(--stagger) * 8 + var(--draw-duration) * ${index * 0.5})`;
const route = `/${lang}/docs/${sdk.package}/`;
// Версия — с PyPI при сборке (lib/versions.ts).
const version = await latestVersion(sdk);
const meta = `${version ? `v${version.version} · ` : ''}${sdk.license} · PYTHON ${sdk.python}`;
const githubLabel = `${sdk.package} ${t(lang, 'nav.onGithub')}`;
const id = `sdk-${sdk.package}`;
const video = sdk.video && `/media/${sdk.video}`;
---

<!-- Десктоп: панель целиком — ссылка на документацию, GitHub — соседняя ссылка. -->
<div class="panel" data-rise style={order}>
  <!-- Видео, стена обложек или строка чтения — только по наведению: до этого ничего не грузится
       (источники видео ставит скрипт ниже, обложки — CoverWall.astro). -->
  {
    video && (
      <div class="media" aria-hidden="true">
        <img class="media-poster" src={`${video}-poster.webp`} alt="" loading="lazy" decoding="async" />
        <video class="media-video" data-src={video} muted loop playsinline preload="none" disablepictureinpicture></video>
      </div>
    )
  }
  {
    sdk.covers && (
      <div class="media" aria-hidden="true">
        <CoverWall name={sdk.covers} />
      </div>
    )
  }
  {
    sdk.phrases && (
      <div class="media" aria-hidden="true">
        <ReadingLine name={sdk.phrases} />
      </div>
    )
  }
  <a class="panel-link" href={route} aria-label={`${sdk.kana} — ${sdk.label[lang]}: ${sdk.package}, ${t(lang, 'nav.docs').toLowerCase()}`}></a>

  <div class="title" aria-hidden="true">
    <span class="jp kana" lang="ja" data-draw style={drawOrder}>{sdk.kana}</span>
    <span class="label">{sdk.label[lang]}</span>
  </div>

  <div class="details">
    <div class="meta">{sdk.platform}</div>
    <div class="package">{sdk.package}</div>
    <div class="rule"></div>
    <p class="description">{sdk.description[lang]}</p>
    <div class="facts"><span>/docs/{sdk.package}/</span><span>{meta}</span></div>
    <div class="actions">
      <span class="docs-cta" aria-hidden="true">{t(lang, 'nav.docs').toUpperCase()} ↗</span>
      <GithubButton href={sdk.github} label={githubLabel} />
    </div>
  </div>
</div>

<!-- Мобильный: аккордеон. -->
<section class="accordion" data-rise style={order}>
  <h2>
    <button type="button" aria-expanded="false" aria-controls={id}>
      <span class="acc-head">
        <span class="acc-package">{sdk.package}</span>
        <span class="acc-state meta">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.1" fill="none"></path></svg>
          <span class="when-closed">{t(lang, 'panel.open').toUpperCase()}</span>
          <span class="when-open">{t(lang, 'panel.close').toUpperCase()}</span>
        </span>
      </span>
      <span class="acc-title" aria-hidden="true">
        <span class="jp" lang="ja">{sdk.kana}</span>
        <span class="label">{sdk.label[lang]}</span>
      </span>
      <span class="visually-hidden">{sdk.label[lang]} — {sdk.platform}</span>
    </button>
  </h2>
  <div class="acc-body" id={id} inert>
    <div class="acc-inner">
    <div class="acc-content">
    {
      video && (
        <div class="media acc-media" aria-hidden="true">
          <img class="media-poster" src={`${video}-poster.webp`} alt="" loading="lazy" decoding="async" />
          <video class="media-video" data-src={video} muted loop playsinline preload="none" disablepictureinpicture></video>
        </div>
      )
    }
    {
      sdk.covers && (
        <div class="media acc-media" aria-hidden="true">
          <CoverWall name={sdk.covers} />
        </div>
      )
    }
    {/* Строки чтения на телефоне нет: описание занимает весь аккордеон, фразы шли бы под текстом. */}
    <div class="meta">{sdk.platform}</div>
    <p class="description">{sdk.description[lang]}</p>
    <div class="facts"><span>/docs/{sdk.package}/</span><span>{meta}</span></div>
    <div class="acc-actions">
      <a class="acc-docs" href={route}>{t(lang, 'nav.docs').toUpperCase()} <span aria-hidden="true">↗</span></a>
      <GithubButton href={sdk.github} label={githubLabel} />
    </div>
    </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid var(--divider);
    background-color: var(--ground);
    transition:
      flex-grow var(--panel-duration) var(--ease),
      flex-basis var(--panel-duration) var(--ease),
      background-color var(--panel-duration);
  }
  .panel:hover,
  .panel:focus-within {
    background-color: var(--panel-hover);
  }
  .panel-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .panel-link:focus-visible {
    outline-offset: -0.625rem;
  }
  .title {
    position: absolute;
    top: 0;
    right: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    pointer-events: none;
  }
  .kana {
    writing-mode: vertical-rl;
    font-size: var(--jp-size);
    letter-spacing: 0.02em;
  }
  .label {
    writing-mode: vertical-rl;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-right: 1px;
  }
  .details {
    position: absolute;
    left: 2.25rem;
    top: 16.25rem;
    /* Ширина — от итоговой ширины раскрытой панели (index.astro: всё, кроме колонок каны
       соседей; 100cqw — ширина ряда панелей), а не от текущей: пока панель расширяется,
       текст не переверстывается. Справа — своя колонка каны. */
    width: min(20rem, calc(100cqw - var(--panel-closed) * (var(--panel-count) - 1) - 9.5rem));
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--reveal-out),
      transform var(--reveal-out);
  }
  .panel:hover .details,
  .panel:focus-within .details {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--reveal-in) var(--reveal-delay),
      transform var(--panel-duration) var(--ease-out) var(--reveal-delay);
  }
  .details .meta {
    font-size: var(--meta-size-lg);
    letter-spacing: 0.22em;
  }
  .package {
    margin-top: 0.875rem;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }
  .rule {
    width: 1.75rem;
    height: 1px;
    margin: 1.375rem 0;
    background: var(--rule);
  }
  .description {
    margin: 0;
    font-size: 1.3125rem;
    line-height: 1.45;
  }
  .facts {
    margin-top: 1.125rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    color: var(--muted);
  }
  .actions {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    gap: 1.375rem;
  }
  .docs-cta {
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    letter-spacing: var(--meta-tracking);
    padding-bottom: 0.3125rem;
    border-bottom: 1px solid var(--ink);
  }
  /* Кнопка GitHub кликабельна, только когда подробности видны. */
  .details :global(.gh-btn) {
    pointer-events: none;
  }
  .panel:hover .details :global(.gh-btn),
  .panel:focus-within .details :global(.gh-btn) {
    pointer-events: auto;
  }

  /* Фоновое видео (#51): ч/б и приглушённое, под описанием уходит в чёрный.
     Проявляется медленно и только после того, как панель раскрылась; гаснет быстрее.
     Сначала постер, кадры видео — поверх него, когда видео действительно пошло. */
  .media {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--video-out) var(--ease);
  }
  .panel:is(:hover, :focus-within) .media {
    opacity: 1;
    transition: opacity var(--video-in) var(--ease) var(--panel-duration);
  }
  .media-poster,
  .media-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.55) contrast(1.05);
  }
  .media-video {
    opacity: 0;
    transition: opacity var(--video-in) var(--ease);
  }
  .media-video.is-ready {
    opacity: 1;
  }
  /* Сверху — немного тени под каной, ниже — плотнее к описанию и в чёрный у низа. */
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ground) 40%, transparent) 0%,
      transparent 18%,
      color-mix(in srgb, var(--ground) 55%, transparent) 32%,
      color-mix(in srgb, var(--ground) 75%, transparent) 70%,
      var(--ground) 100%
    );
  }

  .accordion {
    display: none;
  }

  @media (max-width: 767px) {
    .panel {
      display: none;
    }
    .accordion {
      display: block;
      border-bottom: 1px solid var(--divider);
      transition: background-color var(--expand-duration);
    }
    .accordion.is-open {
      background-color: var(--panel-hover);
    }
    h2 {
      margin: 0;
    }
    button {
      position: relative;
      display: block;
      width: 100%;
      height: 13.25rem;
      padding: 0;
      overflow: hidden;
      background: transparent;
      border: 0;
      color: var(--ink);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .acc-head {
      position: absolute;
      left: 1.25rem;
      top: 1.625rem;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }
    .acc-package {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }
    .acc-state {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .acc-state svg {
      color: var(--ink);
      transition: transform var(--expand-duration) var(--ease);
    }
    [aria-expanded='true'] .acc-state svg {
      transform: rotate(45deg);
    }
    .when-open,
    [aria-expanded='true'] .when-closed {
      display: none;
    }
    [aria-expanded='true'] .when-open {
      display: inline;
    }
    .acc-title {
      position: absolute;
      top: 0;
      right: 1rem;
      display: flex;
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .acc-title .jp {
      writing-mode: vertical-rl;
      font-size: var(--jp-size);
      letter-spacing: 0.02em;
      padding-top: 1.125rem;
    }
    .acc-title .label {
      font-size: 0.75rem;
      padding-top: 1.375rem;
    }
    /* Высота раскрывается плавно: grid-template-rows 0fr ↔ 1fr. */
    .acc-body {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows var(--expand-duration) var(--ease),
        opacity var(--expand-duration) var(--ease);
    }
    .accordion.is-open .acc-body {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .acc-inner {
      min-height: 0;
      overflow: hidden;
    }
    .acc-content {
      position: relative;
      isolation: isolate;
      padding: 2.25rem 1.25rem 2rem;
      border-top: 1px solid var(--divider);
    }
    .acc-content > :not(.media) {
      position: relative;
    }
    /* Видео (#52) — фон раскрытого аккордеона, после того как он раскрылся. */
    .accordion.is-open .acc-media {
      opacity: 1;
      transition: opacity var(--video-in) var(--ease) var(--expand-duration);
    }
    .acc-media::after {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--ground) 40%, transparent) 0%,
        color-mix(in srgb, var(--ground) 85%, transparent) 45%,
        var(--ground) 100%
      );
    }
    .acc-body .description {
      margin-top: 1rem;
      font-size: 1.25rem;
    }
    .acc-body .facts {
      margin-top: 0.875rem;
    }
    .acc-actions {
      margin-top: 1.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .acc-docs {
      flex: 1 1 auto;
      height: var(--tap-min);
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
      border: 1px solid var(--ink);
      font-family: var(--font-mono);
      font-size: var(--meta-size-lg);
      letter-spacing: var(--meta-tracking);
    }
  }
</style>

<script>
  // Видео в панелях (#51, #52): источники ставятся только при первом раскрытии —
  // до этого ни байта видео. При reduced motion и Save-Data — только постер.
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = () => (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  const play = (video: HTMLVideoElement) => {
    if (calm.matches || saveData()) return;
    if (!video.querySelector('source')) {
      for (const type of ['webm', 'mp4']) {
        const source = document.createElement('source');
        source.src = video.dataset.src + '.' + type;
        source.type = 'video/' + type;
        video.append(source);
      }
      video.load();
    }
    video.play().catch(() => {});
  };

  for (const video of document.querySelectorAll<HTMLVideoElement>('.media-video')) {
    // Кадры проявляются поверх постера, только когда видео действительно пошло.
    video.addEventListener('playing', () => video.classList.add('is-ready'), { once: true });
  }

  // Десктоп: наведение или фокус внутри панели.
  for (const panel of document.querySelectorAll<HTMLElement>('.panel')) {
    const video = panel.querySelector<HTMLVideoElement>('.media-video');
    if (!video) continue;
    const sync = () => (panel.matches(':hover, :focus-within') ? play(video) : video.pause());
    panel.addEventListener('pointerenter', () => play(video));
    panel.addEventListener('pointerleave', sync);
    panel.addEventListener('focusin', () => play(video));
    panel.addEventListener('focusout', () => requestAnimationFrame(sync));
  }

  // Мобильный: играет, только пока аккордеон открыт (кнопку переключает index.astro).
  for (const accordion of document.querySelectorAll<HTMLElement>('.accordion')) {
    const video = accordion.querySelector<HTMLVideoElement>('.media-video');
    const button = accordion.querySelector('button');
    if (!video || !button) continue;
    new MutationObserver(() => (button.getAttribute('aria-expanded') === 'true' ? play(video) : video.pause())).observe(button, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    });
  }
</script>
