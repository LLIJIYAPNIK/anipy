---
import GithubButton from './GithubButton.astro';
import type { Sdk } from '../data/sdks';
import { t, type Lang } from '../i18n';

interface Props {
  sdk: Sdk;
  lang: Lang;
  /** Порядок панели: задержка появления и «письма» каны. */
  index?: number;
}

const { sdk, lang, index = 0 } = Astro.props;
// Панели появляются после вводного блока (data-rise --i 1–5 на главной).
const order = `--i: ${index + 6}`;
// Кана «пишется» после того, как появились все панели, — по одной, каждая следующая
// со сдвигом в полдлительности (очерёдность, #45). Только токены: reduced motion обнулит.
const drawOrder = `--after: calc(var(--rise-duration) + var(--stagger) * 8 + var(--draw-duration) * ${index * 0.5})`;
const route = `/${lang}/docs/${sdk.package}/`;
const meta = `${sdk.license} · PYTHON ${sdk.python}`;
const githubLabel = `${sdk.package} ${t(lang, 'nav.onGithub')}`;
const id = `sdk-${sdk.package}`;
---

<!-- Десктоп: панель целиком — ссылка на документацию, GitHub — соседняя ссылка. -->
<div class="panel" data-rise style={order}>
  <a class="panel-link" href={route} aria-label={`${sdk.kana} — ${sdk.label[lang]}: ${sdk.package}, ${t(lang, 'nav.docs').toLowerCase()}`}></a>

  <div class="title" aria-hidden="true">
    <span class="jp kana" lang="ja" data-draw style={drawOrder}>{sdk.kana}</span>
    <span class="label">{sdk.label[lang]}</span>
  </div>

  <div class="details">
    <div class="meta">{sdk.platform}</div>
    <div class="package">{sdk.package}</div>
    <div class="rule"></div>
    <p class="description">{sdk.description[lang]}</p>
    <div class="facts"><span>/docs/{sdk.package}/</span><span>{meta}</span></div>
    <div class="actions">
      <span class="docs-cta" aria-hidden="true">{t(lang, 'nav.docs').toUpperCase()} ↗</span>
      <GithubButton href={sdk.github} label={githubLabel} />
    </div>
  </div>
</div>

<!-- Мобильный: аккордеон. -->
<section class="accordion" data-rise style={order}>
  <h2>
    <button type="button" aria-expanded="false" aria-controls={id}>
      <span class="acc-head">
        <span class="acc-package">{sdk.package}</span>
        <span class="acc-state meta">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.1" fill="none"></path></svg>
          <span class="when-closed">{t(lang, 'panel.open').toUpperCase()}</span>
          <span class="when-open">{t(lang, 'panel.close').toUpperCase()}</span>
        </span>
      </span>
      <span class="acc-title" aria-hidden="true">
        <span class="jp" lang="ja">{sdk.kana}</span>
        <span class="label">{sdk.label[lang]}</span>
      </span>
      <span class="visually-hidden">{sdk.label[lang]} — {sdk.platform}</span>
    </button>
  </h2>
  <div class="acc-body" id={id} inert>
    <div class="acc-inner">
    <div class="acc-content">
    <div class="meta">{sdk.platform}</div>
    <p class="description">{sdk.description[lang]}</p>
    <div class="facts"><span>/docs/{sdk.package}/</span><span>{meta}</span></div>
    <div class="acc-actions">
      <a class="acc-docs" href={route}>{t(lang, 'nav.docs').toUpperCase()} <span aria-hidden="true">↗</span></a>
      <GithubButton href={sdk.github} label={githubLabel} />
    </div>
    </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid var(--divider);
    background-color: var(--ground);
    transition:
      flex-grow var(--panel-duration) var(--ease),
      flex-basis var(--panel-duration) var(--ease),
      background-color var(--panel-duration);
  }
  .panel:hover,
  .panel:focus-within {
    background-color: var(--panel-hover);
  }
  .panel-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .panel-link:focus-visible {
    outline-offset: -0.625rem;
  }
  .title {
    position: absolute;
    top: 0;
    right: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    pointer-events: none;
  }
  .kana {
    writing-mode: vertical-rl;
    font-size: var(--jp-size);
    letter-spacing: 0.02em;
  }
  .label {
    writing-mode: vertical-rl;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-right: 1px;
  }
  .details {
    position: absolute;
    left: 2.25rem;
    top: 16.25rem;
    /* Ширина — от итоговой ширины раскрытой панели (index.astro: min(33vw, 640px)), а не от текущей:
       пока панель расширяется, текст не переверстывается. Справа — колонка каны. */
    width: min(20rem, calc(min(33vw, 640px) - 9.5rem));
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--reveal-out),
      transform var(--reveal-out);
  }
  .panel:hover .details,
  .panel:focus-within .details {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--reveal-in) var(--reveal-delay),
      transform var(--panel-duration) var(--ease-out) var(--reveal-delay);
  }
  .details .meta {
    font-size: var(--meta-size-lg);
    letter-spacing: 0.22em;
  }
  .package {
    margin-top: 0.875rem;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }
  .rule {
    width: 1.75rem;
    height: 1px;
    margin: 1.375rem 0;
    background: var(--rule);
  }
  .description {
    margin: 0;
    font-size: 1.3125rem;
    line-height: 1.45;
  }
  .facts {
    margin-top: 1.125rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    color: var(--muted);
  }
  .actions {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    gap: 1.375rem;
  }
  .docs-cta {
    font-family: var(--font-mono);
    font-size: var(--meta-size-lg);
    letter-spacing: var(--meta-tracking);
    padding-bottom: 0.3125rem;
    border-bottom: 1px solid var(--ink);
  }
  /* Кнопка GitHub кликабельна, только когда подробности видны. */
  .details :global(.gh-btn) {
    pointer-events: none;
  }
  .panel:hover .details :global(.gh-btn),
  .panel:focus-within .details :global(.gh-btn) {
    pointer-events: auto;
  }

  .accordion {
    display: none;
  }

  @media (max-width: 767px) {
    .panel {
      display: none;
    }
    .accordion {
      display: block;
      border-bottom: 1px solid var(--divider);
      transition: background-color var(--expand-duration);
    }
    .accordion.is-open {
      background-color: var(--panel-hover);
    }
    h2 {
      margin: 0;
    }
    button {
      position: relative;
      display: block;
      width: 100%;
      height: 13.25rem;
      padding: 0;
      overflow: hidden;
      background: transparent;
      border: 0;
      color: var(--ink);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .acc-head {
      position: absolute;
      left: 1.25rem;
      top: 1.625rem;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }
    .acc-package {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }
    .acc-state {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .acc-state svg {
      color: var(--ink);
      transition: transform var(--expand-duration) var(--ease);
    }
    [aria-expanded='true'] .acc-state svg {
      transform: rotate(45deg);
    }
    .when-open,
    [aria-expanded='true'] .when-closed {
      display: none;
    }
    [aria-expanded='true'] .when-open {
      display: inline;
    }
    .acc-title {
      position: absolute;
      top: 0;
      right: 1rem;
      display: flex;
      flex-direction: row-reverse;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .acc-title .jp {
      writing-mode: vertical-rl;
      font-size: var(--jp-size);
      letter-spacing: 0.02em;
      padding-top: 1.125rem;
    }
    .acc-title .label {
      font-size: 0.75rem;
      padding-top: 1.375rem;
    }
    /* Высота раскрывается плавно: grid-template-rows 0fr ↔ 1fr. */
    .acc-body {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows var(--expand-duration) var(--ease),
        opacity var(--expand-duration) var(--ease);
    }
    .accordion.is-open .acc-body {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .acc-inner {
      min-height: 0;
      overflow: hidden;
    }
    .acc-content {
      padding: 2.25rem 1.25rem 2rem;
      border-top: 1px solid var(--divider);
    }
    .acc-body .description {
      margin-top: 1rem;
      font-size: 1.25rem;
    }
    .acc-body .facts {
      margin-top: 0.875rem;
    }
    .acc-actions {
      margin-top: 1.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .acc-docs {
      flex: 1 1 auto;
      height: var(--tap-min);
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
      border: 1px solid var(--ink);
      font-family: var(--font-mono);
      font-size: var(--meta-size-lg);
      letter-spacing: var(--meta-tracking);
    }
  }
</style>
