---
// Поиск по документации (#68): Pagefind — статический индекс, собирается после astro build
// (`pagefind --site dist`), сервер не нужен. Открывается кнопкой в шапке и по Ctrl+K / ⌘K.
// Индекс у каждого языка свой (по <html lang>), фильтр — набор документации (SDK или ядро).
import { docSetKey, isSdk } from '../data/sdks';
import { docSets } from '../lib/mkdocs';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const filters = docSets.map((set) => ({ key: docSetKey(set), label: isSdk(set) ? set.label[lang] : docSetKey(set) }));
---

<button class="search-open meta" type="button" aria-haspopup="dialog" aria-controls="docs-search">
  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.2"></path>
  </svg>
  <span>{t(lang, 'search.open').toUpperCase()}</span>
  <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
</button>

<dialog
  class="search"
  id="docs-search"
  aria-label={t(lang, 'search.placeholder')}
  data-empty={t(lang, 'search.empty')}
  data-unavailable={t(lang, 'search.unavailable')}
  data-count={t(lang, 'search.count')}
>
  <div class="search-panel">
    <div class="search-head">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
        <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.2"></path>
      </svg>
      <input
        class="search-input"
        type="search"
        placeholder={t(lang, 'search.placeholder')}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="docs-search-results"
        aria-autocomplete="list"
      />
      <button class="search-close meta" type="button" aria-label={t(lang, 'search.close')}>ESC</button>
    </div>
    <div class="search-filters" role="group" aria-label={t(lang, 'search.filter')}>
      <button type="button" class="search-chip meta" aria-pressed="true" data-filter="">{t(lang, 'search.all').toUpperCase()}</button>
      {
        filters.map((f) => (
          <button type="button" class="search-chip meta" aria-pressed="false" data-filter={f.key}>
            {f.label.toUpperCase()}
          </button>
        ))
      }
    </div>
    <ul class="search-results" id="docs-search-results" role="listbox" aria-label={t(lang, 'search.results')}></ul>
    <p class="search-status meta" aria-live="polite"></p>
    <p class="search-hint meta" aria-hidden="true">{t(lang, 'search.hint').toUpperCase()}</p>
  </div>
</dialog>

<script>
  type Result = {
    url: string;
    meta: { title?: string };
    excerpt: string;
    filters: { sdk?: string[] };
    sub_results?: { title: string; url: string; excerpt: string; locations?: number[] }[];
  };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    debouncedSearch: (q: string, o?: { filters?: Record<string, string> }, ms?: number) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('#docs-search')!;
  const open = document.querySelector<HTMLButtonElement>('.search-open')!;
  const input = dialog.querySelector<HTMLInputElement>('.search-input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const status = dialog.querySelector<HTMLParagraphElement>('.search-status')!;
  const chips = [...dialog.querySelectorAll<HTMLButtonElement>('.search-chip')];

  // Клавиша-модификатор — как у системы.
  if (/Mac OS X|iPhone|iPad/.test(navigator.userAgent)) open.querySelector('.search-kbd')!.textContent = '⌘ K';

  // Индекс есть только в собранном сайте (pagefind после astro build); путь — строкой, чтобы его не трогал Vite.
  let pagefind: Promise<Pagefind | null> | undefined;
  const load = () =>
    (pagefind ??= (async () => {
      try {
        const path = '/pagefind/pagefind.js';
        const module = (await import(/* @vite-ignore */ path)) as Pagefind;
        await module.options({ excerptLength: 22 });
        return module;
      } catch {
        return null;
      }
    })());

  let filter = '';
  let active = -1;
  let seq = 0;

  const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
  const select = (index: number) => {
    const links = items();
    active = links.length ? (index + links.length) % links.length : -1;
    links.forEach((a, i) => a.setAttribute('aria-selected', String(i === active)));
    links[active]?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', links[active]?.id ?? '');
  };

  const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const run = async () => {
    const query = input.value.trim();
    const mine = ++seq;
    if (!query) {
      list.replaceChildren();
      status.textContent = '';
      input.setAttribute('aria-expanded', 'false');
      return;
    }
    const pf = await load();
    if (mine !== seq) return;
    if (!pf) {
      status.textContent = dialog.dataset.unavailable ?? '';
      return;
    }
    const search = await pf.debouncedSearch(query, filter ? { filters: { sdk: filter } } : {}, 160);
    if (!search || mine !== seq) return;
    const results = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
    if (mine !== seq) return;
    list.replaceChildren(
      ...results.map((r, i) => {
        // Раздел страницы с наибольшим числом совпадений — ссылка сразу на него;
        // если больше всего совпадений до первого заголовка — на саму страницу.
        const best = [...(r.sub_results ?? [])].sort((a, b) => (b.locations?.length ?? 0) - (a.locations?.length ?? 0))[0];
        const sub = best && best.url !== r.url ? best : undefined;
        const li = document.createElement('li');
        li.innerHTML =
          `<a id="search-result-${i}" role="option" aria-selected="false" href="${escape(sub?.url ?? r.url)}">` +
          `<span class="search-result-head"><span class="search-result-title">${escape(r.meta.title ?? r.url)}` +
          (sub ? ` <span class="search-result-section">› ${escape(sub.title)}</span>` : '') +
          `</span><span class="search-result-sdk meta">${escape((r.filters.sdk?.[0] ?? '').toUpperCase())}</span></span>` +
          // Pagefind отдаёт отрывок уже экранированным, с <mark> вокруг совпадений.
          `<span class="search-result-excerpt">${sub?.excerpt ?? r.excerpt}</span></a>`;
        li.classList.add('tab-enter');
        li.style.setProperty('animation-delay', `calc(var(--stagger) * ${i})`);
        return li;
      }),
    );
    input.setAttribute('aria-expanded', String(results.length > 0));
    status.textContent = results.length
      ? (dialog.dataset.count ?? '').replace('{n}', String(search.results.length))
      : (dialog.dataset.empty ?? '');
    select(results.length ? 0 : -1);
  };

  const show = () => {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load();
  };

  open.addEventListener('click', show);
  dialog.querySelector('.search-close')!.addEventListener('click', () => dialog.close());
  // Клик по затемнению вокруг панели закрывает поиск.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  input.addEventListener('input', run);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      select(active + (event.key === 'ArrowDown' ? 1 : -1));
    } else if (event.key === 'Enter' && active >= 0) {
      event.preventDefault();
      items()[active]?.click();
    }
  });
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      input.focus();
      run();
    });
  }
  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else show();
    }
  });
</script>

<style>
  .search-open {
    height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-left: 0.5rem;
    padding: 0 0.875rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--secondary);
    font-size: var(--meta-size-lg);
    cursor: pointer;
    transition:
      border-color var(--hover-duration) var(--ease-out),
      color var(--hover-duration) var(--ease-out);
  }
  .search-open:is(:hover, :focus-visible) {
    border-color: var(--ink);
    color: var(--ink);
  }
  .search-kbd {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--divider);
    font: inherit;
    font-size: var(--meta-size);
    color: var(--muted);
  }

  .search {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }
  .search::backdrop {
    background: color-mix(in srgb, var(--ground) 82%, transparent);
  }
  .search[open]::backdrop {
    animation: search-fade var(--rise-duration) var(--ease-out) both;
  }
  .search[open] .search-panel {
    animation: tab-rise var(--rise-duration) var(--ease-out) both;
  }
  @keyframes search-fade {
    from {
      opacity: 0;
    }
  }
  .search-panel {
    width: min(46rem, calc(100% - 2 * var(--page-gutter)));
    margin: 12vh auto 0;
    display: flex;
    flex-direction: column;
    max-height: 76vh;
    border: 1px solid var(--divider);
    background: var(--ground);
  }
  .search-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0 1rem 0 1.25rem;
    border-bottom: 1px solid var(--divider);
    color: var(--secondary);
  }
  .search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 3.75rem;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.375rem;
  }
  .search-input::placeholder {
    color: var(--muted);
  }
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
  .search-close {
    height: 2rem;
    padding: 0 0.625rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--muted);
    cursor: pointer;
  }
  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--rule-faint);
  }
  .search-chip {
    padding: 0.375rem 0.625rem;
    background: transparent;
    border: 1px solid var(--divider);
    color: var(--secondary);
    cursor: pointer;
    transition:
      background-color var(--hover-duration) var(--ease-out),
      border-color var(--hover-duration) var(--ease-out),
      color var(--hover-duration) var(--ease-out);
  }
  .search-chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ground);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .search-results :global(a) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--rule-faint);
    border-left: 2px solid transparent;
    color: var(--ink);
    transition:
      background-color var(--hover-duration) var(--ease-out),
      border-color var(--hover-duration) var(--ease-out);
  }
  .search-results :global(a:is(:hover, [aria-selected='true'])) {
    background: var(--panel-hover);
    border-left-color: var(--ink);
  }
  .search-results :global(.search-result-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .search-results :global(.search-result-title) {
    font-size: 1.1875rem;
  }
  .search-results :global(.search-result-section) {
    color: var(--secondary);
  }
  .search-results :global(.search-result-sdk) {
    flex: 0 0 auto;
    color: var(--muted);
  }
  .search-results :global(.search-result-excerpt) {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--secondary);
  }
  .search-results :global(mark) {
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .search-status,
  .search-hint {
    margin: 0;
    padding: 0.75rem 1.25rem;
    color: var(--muted);
  }
  .search-status:empty {
    display: none;
  }
  .search-hint {
    border-top: 1px solid var(--rule-faint);
  }

  @media (max-width: 767px) {
    .search-kbd,
    .search-hint {
      display: none;
    }
    .search-panel {
      width: 100%;
      margin: 0;
      max-height: 100%;
      height: 100%;
      border: 0;
    }
  }
</style>
