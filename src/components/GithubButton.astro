---
// Единая кнопка GitHub на весь сайт: круг с тонкой рамкой. Наведение (заливка белым,
// чёрная иконка, поворот) — в styles/motion.css по классу .gh-btn.
import GithubIcon from './GithubIcon.astro';

interface Props {
  href: string;
  /** Подпись для скринридеров: «<что> на GitHub (откроется в новой вкладке)». */
  label: string;
}

const { href, label } = Astro.props;
---

<a class="gh-btn" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  <GithubIcon />
</a>

<style>
  .gh-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink);
  }
  .gh-btn :global(svg) {
    width: 1.0625rem;
    height: 1.0625rem;
  }
</style>
